# ===================================================
# DATABASE (MySQL) CONFIGURATION
# ===================================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/Hotel_Managment
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ===================================================
# REDIS CONFIGURATION
# ===================================================
SPRING_DATA_REDIS_HOST=your_redis_host
SPRING_DATA_REDIS_PORT=10818
SPRING_DATA_REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# ===================================================
# BREVO EMAIL SERVICE CONFIGURATION
# ===================================================
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME=Hotel Aatithya

# ===================================================
# TWILIO SMS SERVICE CONFIGURATION
# ===================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ===================================================
# RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ===================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ===================================================
# SERVER CONFIGURATION
# ===================================================
SERVER_PORT=8080
