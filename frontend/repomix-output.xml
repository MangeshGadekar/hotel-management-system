              </li>
              <li>
                <NavLink
                  to="/contact"
                  className={({ isActive }) => 
                    `block font-medium py-2 px-3 hover:bg-amber-50 rounded-lg transition-colors ${
                      isActive 
                        ? "text-amber-600 font-semibold bg-amber-50" 
